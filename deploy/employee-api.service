[Unit]
Description=Employee Management API (FastAPI via Gunicorn + Uvicorn workers)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/employee-management-api
EnvironmentFile=/etc/employee-api.env
ExecStart=/home/ubuntu/employee-management-api/.venv/bin/gunicorn app.main:app -c /home/ubuntu/employee-management-api/deploy/gunicorn_conf.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
