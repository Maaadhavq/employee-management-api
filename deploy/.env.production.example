# Production environment file. On the EC2 box, copy this to /etc/employee-api.env,
# fill in the real RDS endpoint/password and your S3 bucket name, then run:
#   sudo systemctl restart employee-api
#
# IMPORTANT: do NOT put AWS access keys here. The EC2 instance's IAM role
# supplies S3 credentials automatically.

DATABASE_URL=postgresql://empadmin:YOUR_RDS_PASSWORD@YOUR-RDS-ENDPOINT.ap-south-1.rds.amazonaws.com:5432/employee_db
SQL_ECHO=False

ENVIRONMENT=production

AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-unique-employee-exports-bucket
S3_PRESIGNED_URL_TTL=3600
