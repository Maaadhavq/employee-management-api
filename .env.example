# ---------------------------------------------------------------------------
# Local development configuration. Copy to .env and adjust.
# (.env is gitignored; never commit real secrets.)
# ---------------------------------------------------------------------------

# Database (local PostgreSQL)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/employee_db
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/employee_test_db
SQL_ECHO=False

# Deployment environment: development | production
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# AWS / S3. The CSV-export endpoint uses these.
#   * Locally, leave S3_BUCKET_NAME blank to disable the export feature, or set
#     it and authenticate via `aws configure` / env credentials.
#   * On EC2, do NOT set AWS access keys here -- the attached IAM role supplies
#     credentials automatically. Only set the region and bucket name.
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PRESIGNED_URL_TTL=3600
