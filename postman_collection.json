{
  "info": {
    "name": "Employee Management API",
    "description": "Week 2 deliverable - CRUD REST API for managing employees. Set the {{base_url}} collection variable (default http://127.0.0.1:8000). The 'Create Employee' request saves the new id into {{employee_id}} so the GET/PUT/PATCH/DELETE requests can reuse it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "employee_id",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Create Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "if (body.id) { pm.collectionVariables.set('employee_id', body.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Katherine Johnson\",\n  \"email\": \"katherine.johnson@example.com\",\n  \"department\": \"Finance\",\n  \"position\": \"Financial Analyst\",\n  \"salary\": 92000\n}"
        },
        "url": { "raw": "{{base_url}}/employees", "host": ["{{base_url}}"], "path": ["employees"] }
      }
    },
    {
      "name": "List Employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/employees?page=1&page_size=20",
          "host": ["{{base_url}}"],
          "path": ["employees"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" },
            { "key": "department", "value": "Engineering", "disabled": true },
            { "key": "is_active", "value": "true", "disabled": true },
            { "key": "search", "value": "ada", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Get Employee By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/employees/{{employee_id}}",
          "host": ["{{base_url}}"],
          "path": ["employees", "{{employee_id}}"]
        }
      }
    },
    {
      "name": "Replace Employee (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Katherine Johnson\",\n  \"email\": \"katherine.johnson@example.com\",\n  \"department\": \"Finance\",\n  \"position\": \"Senior Financial Analyst\",\n  \"salary\": 108000,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/employees/{{employee_id}}",
          "host": ["{{base_url}}"],
          "path": ["employees", "{{employee_id}}"]
        }
      }
    },
    {
      "name": "Update Employee (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"salary\": 115000\n}"
        },
        "url": {
          "raw": "{{base_url}}/employees/{{employee_id}}",
          "host": ["{{base_url}}"],
          "path": ["employees", "{{employee_id}}"]
        }
      }
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/employees/{{employee_id}}",
          "host": ["{{base_url}}"],
          "path": ["employees", "{{employee_id}}"]
        }
      }
    }
  ]
}
